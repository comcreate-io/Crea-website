# Copy to .env.local for local development. Never commit real values.

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Set in Vercel for the Production environment only. Leave unset on Preview
# and Development: the GA tag renders nothing and no data is sent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend (transactional email for the contact form).
# RESEND_FROM must be an address on the verified sending domain, for example
# "Crea Development <inquiries@crea-development.com>".
# RESEND_TO is a comma-separated recipient list.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Durable submissions log (Google Sheet via Apps Script web app, or any
# inbound webhook). Optional: when LEAD_WEBHOOK_URL is unset nothing is
# logged and the form still sends email. The secret is sent in the JSON body
# and checked by the receiving script.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
